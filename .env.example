DB_URL=jdbc:postgresql://localhost:5434/stevil_db
DB_NAME=stevil_db
DB_USERNAME=stevil_user
DB_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=


JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000

# 로그인 성공 후 이동할 프론트 주소
FRONTEND_URL=http://localhost:3000
# Frontend build and backend AI/search settings (set real values only in .env)
VITE_NAVER_MAP_CLIENT_ID=
GEMINI_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
PLANNER_GENERATOR_URL=http://rag-api:8091/api/plan

# Separate RAG Compose project; supply these through its --env-file
GEMINI_MODEL=
RAG_DATABASE_URL=

# FCM push delivery (PR-B). Keep false until the key is placed on the server and PR-C/PR-D are deployed.
STEVIL_FIREBASE_ENABLED=false
# Host path of the service-account JSON (outside the repo, root:root 600). Path only - never the JSON content.
FIREBASE_SERVICE_ACCOUNT_FILE=

# Personal reminder scheduler (PR-C). Off by default; set true only after verifying the deploy.
STEVIL_REMINDER_SCHEDULER_ENABLED=false
